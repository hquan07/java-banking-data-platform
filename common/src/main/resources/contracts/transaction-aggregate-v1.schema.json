{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hquan07/java-banking-data-platform/contracts/transaction-aggregate-v1.schema.json",
  "title": "TransactionAggregateEvent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "aggregate_id", "window_key", "window_start", "window_end", "currency",
    "transaction_count", "total_amount", "failed_count", "schema_version"
  ],
  "properties": {
    "aggregate_id": {"type": "string", "format": "uuid"},
    "window_key": {"type": "string", "minLength": 1, "maxLength": 128},
    "window_start": {"type": "string", "format": "date-time"},
    "window_end": {"type": "string", "format": "date-time"},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "transaction_count": {"type": "integer", "minimum": 1},
    "total_amount": {"type": "string", "pattern": "^(?:0|[1-9][0-9]{0,16})\\.[0-9]{2}$"},
    "failed_count": {"type": "integer", "minimum": 0},
    "schema_version": {"const": 1}
  }
}
