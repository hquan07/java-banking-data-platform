{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hquan07/java-banking-data-platform/contracts/transaction-created-v1.schema.json",
  "title": "TransactionCreatedEvent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "transaction_id",
    "account_id",
    "transaction_type",
    "amount",
    "currency",
    "status",
    "occurred_at",
    "produced_at"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "transaction.created"
    },
    "schema_version": {
      "const": 1
    },
    "transaction_id": {
      "type": "string",
      "format": "uuid"
    },
    "account_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "transaction_type": {
      "enum": ["DEPOSIT", "WITHDRAWAL", "PAYMENT", "TRANSFER"]
    },
    "amount": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,16})\\.[0-9]{2}$"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "status": {
      "enum": ["PENDING", "SUCCESS", "FAILED", "REVERSED"]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "produced_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 128
    }
  }
}
