{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hquan07/java-banking-data-platform/contracts/fraud-alert-v1.schema.json",
  "title": "FraudAlertEvent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "alert_id", "rule", "rule_version", "account_id", "currency",
    "observed_count", "window_start", "window_end", "detected_at", "schema_version"
  ],
  "properties": {
    "alert_id": {"type": "string", "format": "uuid"},
    "rule": {"enum": ["HIGH_VALUE", "VELOCITY_60S"]},
    "rule_version": {"const": "demo-v1"},
    "event_id": {"type": ["string", "null"], "format": "uuid"},
    "account_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"},
    "amount": {"type": ["string", "null"], "pattern": "^(?:0|[1-9][0-9]{0,16})\\.[0-9]{2}$"},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "observed_count": {"type": "integer", "minimum": 1},
    "window_start": {"type": "string", "format": "date-time"},
    "window_end": {"type": "string", "format": "date-time"},
    "detected_at": {"type": "string", "format": "date-time"},
    "schema_version": {"const": 1}
  }
}
