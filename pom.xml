<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.hquan07.banking</groupId>
    <artifactId>java-banking-data-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Java Real-Time Banking Data Platform</name>
    <description>Portfolio data platform for synthetic banking transactions.</description>

    <modules>
        <module>common</module>
        <module>services/transaction-service</module>
        <module>services/transaction-generator</module>
        <module>services/outbox-publisher</module>
        <module>services/streaming-processor</module>
        <module>services/lake-writer</module>
        <module>services/warehouse-writer</module>
        <module>services/batch-processor</module>
        <module>services/analytics-service</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>3.5.16</spring-boot.version>
        <json-schema-validator.version>2.0.4</json-schema-validator.version>
        <flink.version>2.1.3</flink.version>
        <flink-kafka-connector.version>5.0.0-2.1</flink-kafka-connector.version>
        <flink-kafka-client.version>4.2.0</flink-kafka-client.version>
        <minio-java.version>9.0.3</minio-java.version>
        <parquet.version>1.18.1</parquet.version>
        <avro.version>1.12.1</avro.version>
        <hadoop.version>3.4.2</hadoop.version>
        <maven-shade-plugin.version>3.6.0</maven-shade-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                    <configuration>
                        <useModulePath>false</useModulePath>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
